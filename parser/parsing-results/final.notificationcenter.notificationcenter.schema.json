[
  {
    "component": "notificationcenter",
    "interface": "INotificationCenterProps",
    "originalInterface": "INotificationCenterProps",
    "dependencies": [
      "forwardRef",
      "useCallback",
      "useImperativeHandle",
      "useRef",
      "INotification",
      "INotificationCenterProps",
      "INotificationCenterRef"
    ],
    "type": "object",
    "properties": {
      "maxVisible": {
        "type": "number",
        "description": "Maximum number of notifications rendered simultaneously. Oldest entries are dropped when the limit is exceeded.",
        "default": 5
      },
      "position": {
        "type": "string",
        "enum": [
          "top-right",
          "top-left",
          "bottom-right",
          "bottom-left",
          "top-center",
          "bottom-center"
        ],
        "description": "Fixed screen position of the notification stack.",
        "default": "top-right"
      },
      "className": {
        "type": "string",
        "description": "Additional CSS class applied to the container"
      },
      "style": {
        "tsType": "React.CSSProperties",
        "description": "Inline styles applied to the container"
      }
    },
    "additionalProperties": false,
    "cssClasses": [
      "'info'}",
      "??",
      "Cui-NotificationCenter__item",
      "Cui-NotificationCenter__item--${n.severity",
      "Cui-NotificationCenter__item-close",
      "Cui-NotificationCenter__item-message",
      "Cui-NotificationCenter__item-title"
    ],
    "docs": {
      "imports": "import { NotificationCenter } from '@common-ui';\r\nimport type { INotificationCenterRef } from '@common-ui';",
      "demos": [
        {
          "exportName": "notificationCenterDefaultDemo",
          "label": "notification Center Default",
          "code": [
            "() => {",
            "  const ncRef = useRef(null);",
            "",
            "  return (",
            "    <div style={{ padding: 40 }}>",
            "      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>",
            "        <button onClick={() => ncRef.current?.push({ id: Date.now().toString(), severity: 'info',    message: 'Info notification.',    duration: 4000 })}>Info</button>",
            "        <button onClick={() => ncRef.current?.push({ id: Date.now().toString(), severity: 'success', message: 'Success notification.', duration: 4000 })}>Success</button>",
            "        <button onClick={() => ncRef.current?.push({ id: Date.now().toString(), severity: 'warning', message: 'Warning notification.', duration: 4000 })}>Warning</button>",
            "        <button onClick={() => ncRef.current?.push({ id: Date.now().toString(), severity: 'error',   message: 'Error notification.',   duration: 4000 })}>Error</button>",
            "        <button onClick={() => ncRef.current?.dismissAll()}>Dismiss all</button>",
            "      </div>",
            "      <NotificationCenter ref={ncRef} position=\"top-right\" />",
            "    </div>",
            "  );",
            "}"
          ]
        },
        {
          "exportName": "notificationCenterPersistentDemo",
          "label": "notification Center Persistent",
          "code": [
            "() => {",
            "  const ncRef = useRef(null);",
            "  let counter = 0;",
            "",
            "  const push = (severity, title, message) => {",
            "    ncRef.current?.push({ id: \\`n-\\${++counter}\\`, severity, title, message, duration: 0 });",
            "  };",
            "",
            "  return (",
            "    <div style={{ padding: 40 }}>",
            "      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>",
            "        <button onClick={() => push('success', 'File saved',   'config.json was saved successfully.')}>Save success</button>",
            "        <button onClick={() => push('warning', 'Low memory',   'Available heap is below 10%.')}>Memory warning</button>",
            "        <button onClick={() => push('error',   'Build failed', 'TypeScript compilation error on line 42.')}>Build error</button>",
            "        <button onClick={() => ncRef.current?.dismissAll()} style={{ marginLeft: 16 }}>Clear all</button>",
            "        <button onClick={() => alert('Count: ' + ncRef.current?.getCount())}>Get count</button>",
            "      </div>",
            "      <NotificationCenter ref={ncRef} position=\"top-right\" maxVisible={3} />",
            "    </div>",
            "  );",
            "}"
          ]
        },
        {
          "exportName": "notificationCenterImperativeDismissDemo",
          "label": "notification Center Imperative Dismiss",
          "code": [
            "() => {",
            "  const ncRef = useRef(null);",
            "  const savedIdRef = useRef(null);",
            "",
            "  const startSave = () => {",
            "    const id = 'save-progress';",
            "    savedIdRef.current = id;",
            "    ncRef.current?.push({ id, severity: 'info', title: 'Saving…', message: 'Your changes are being saved.' });",
            "",
            "    setTimeout(() => {",
            "      ncRef.current?.dismiss(id);",
            "      ncRef.current?.push({ id: 'save-done', severity: 'success', message: 'Changes saved successfully!', duration: 3000 });",
            "    }, 2000);",
            "  };",
            "",
            "  return (",
            "    <div style={{ padding: 40 }}>",
            "      <button onClick={startSave}>Save changes</button>",
            "      <NotificationCenter ref={ncRef} position=\"top-right\" />",
            "    </div>",
            "  );",
            "}"
          ]
        }
      ],
      "stories": [
        {
          "exportName": "Default",
          "label": "Default",
          "args": {
            "position": "top-right",
            "maxVisible": 5
          },
          "code": [
            "<NotificationCenter",
            "  position=\"top-right\"",
            "  maxVisible={5}",
            "/>"
          ]
        },
        {
          "exportName": "WithTitles",
          "label": "With Titles",
          "args": {
            "position": "top-right",
            "maxVisible": 5
          },
          "code": [
            "<NotificationCenter",
            "  position=\"top-right\"",
            "  maxVisible={5}",
            "/>"
          ]
        },
        {
          "exportName": "MaxVisible",
          "label": "Max Visible (3)",
          "args": {
            "maxVisible": 3,
            "position": "top-right"
          },
          "code": [
            "<NotificationCenter",
            "  maxVisible={3}",
            "  position=\"top-right\"",
            "/>"
          ]
        },
        {
          "exportName": "BottomLeft",
          "label": "Position: Bottom Left",
          "args": {
            "position": "bottom-left",
            "maxVisible": 5
          },
          "code": [
            "<NotificationCenter",
            "  position=\"bottom-left\"",
            "  maxVisible={5}",
            "/>"
          ]
        }
      ]
    }
