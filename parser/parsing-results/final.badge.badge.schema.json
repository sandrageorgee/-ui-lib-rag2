        "type": "number",
        "description": "If count exceeds this value, the badge displays `${max}+`.",
        "default": 99
      },
      "showZero": {
        "type": "boolean",
        "description": "Controls whether the badge is visible even when count is zero.",
        "default": false
      },
      "variant": {
        "type": "string",
        "enum": [
          "standard",
          "dot"
        ],
        "description": "Visual variant of the badge.\n- \"standard\" renders the count number.\n- \"dot\" renders a small coloured dot with no text.",
        "typeName": "BadgeVariant"
      },
      "color": {
        "type": "string",
        "enum": [
          "default",
          "primary",
          "secondary",
          "error",
          "info",
          "success",
          "warning"
        ],
        "description": "Colour of the badge indicator.",
        "typeName": "BadgeColor"
      },
      "invisible": {
        "type": "boolean",
        "description": "When true the badge is not rendered.",
        "default": false
      },
      "className": {
        "type": "string",
        "description": "Additional CSS class names applied to the root element."
      }
    },
    "additionalProperties": false,
    "description": "Interface for the Badge component. A small numeric or status descriptor anchored to a child element.",
    "defaultValues": {
      "max": 99,
      "showZero": false,
      "variant": "standard",
      "color": "error",
