            "        collapsible",
            "      >",
            "        <p style={{ margin: 0 }}>Content for section A. This panel can be collapsed by the user.</p>",
            "      </DataPanel>",
            "      <DataPanel",
            "        id=\"collapsible-panel-2\"",
            "        title=\"Section B\"",
            "        subtitle=\"Starts collapsed\"",
            "        collapsible",
            "        defaultCollapsed",
            "      >",
            "        <p style={{ margin: 0 }}>Content for section B — only visible when expanded.</p>",
            "      </DataPanel>",
            "    </div>",
            "  );",
            "}"
