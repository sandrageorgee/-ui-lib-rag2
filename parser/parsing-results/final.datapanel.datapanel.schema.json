        "description": "Message shown inside the body when children is empty and loading is false."
      },
      "loading": {
        "type": "boolean",
        "description": "When true the body shows a loading spinner instead of children.",
        "default": false
      },
      "footerJustify": {
        "type": "string",
        "enum": [
          "flex-start",
          "center",
          "flex-end",
          "space-between"
        ],
        "description": "Horizontal alignment of footer action buttons.",
        "default": "flex-end"
      },
      "className": {
        "type": "string",
        "description": "Additional CSS class names applied to the root element."
      },
      "style": {
        "type": "object",
        "description": "DOM type: React.CSSProperties"
      }
    },
    "required": [
      "id",
      "title"
    ],
    "additionalProperties": false,
    "description": "Props for the top-level DataPanel component. DataPanel composes DataPanelHeader, DataPanelBody, and DataPanelFooter into a single managed panel with optional collapsible behaviour.",
    "defaultValues": {
      "show": "true",
      "collapsible": "false",
      "defaultCollapsed": "false",
      "loading": "false",
      "footerJustify": "flex-end"
    },
    "usageExamples": [
      "<div\r\n      id={id}\r\n      className={`${baseClass} ${className}`.trim()}\r\n      style={style}\r\n      role=\"region\"\r\n      aria-labelledby={`${id}-title`}\r\n    >\r\n      <DataPanelHeader\r\n        id={`${id}-header`}\r\n        title={title}\r\n        subtitle={subtitle}\r\n        icon={icon}\r\n        collapsible={collapsible}\r\n        collapsed={collapsed}\r\n        onToggleCollapse={collapsible ? handleToggleCollapse : undefined}\r\n        onClose={onClose}\r\n      />\r\n\r\n      <DataPanelBody\r\n        loading={loading}\r\n        emptyMessage={emptyMessage}\r\n        collapsed={collapsed}\r\n      >\r\n        {children}\r\n      </DataPanelBody>\r\n\r\n      {actions.length > 0 && !collapsed && (\r\n        <DataPanelFooter actions={actions} justify={footerJustify} />\r\n      )}\r\n    </div>"
    ]
  },
