      "SymbolType",
      "renderSymbolOnCanvas"
    ],
    "type": "object",
    "properties": {
      "symbolType": {
        "type": "string",
        "enum": [
          "circle",
          "rect",
          "roundRect",
          "triangle",
          "diamond",
          "pin",
          "arrow",
          "none"
        ],
        "description": "Shape of the symbol to render.",
        "typeName": "SymbolType"
      },
      "size": {
        "type": "number",
        "description": "Width and height of the canvas in pixels.",
        "default": 32
      },
      "color": {
        "type": "string",
        "description": "Fill color of the symbol. Accepts any valid CSS color string.",
        "default": "#3d9ccc"
      },
      "rotate": {
        "type": "number",
        "description": "Rotation angle of the symbol in degrees.",
        "default": 0
      },
      "className": {
        "type": "string",
        "description": "Additional CSS class names applied to the canvas element."
      },
      "style": {
        "tsType": "React.CSSProperties",
        "description": "Inline styles applied to the canvas element."
      }
    },
    "additionalProperties": false,
    "description": "Props for the ChartSymbol component. Renders a single chart marker symbol on a canvas element.",
