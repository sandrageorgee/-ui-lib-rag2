          "error"
        ],
        "description": "Severity levels for the Alert component."
      },
      "message": {
        "type": "string",
        "description": "The main message text displayed inside the alert."
      },
      "title": {
        "type": "string",
        "description": "Optional title displayed above the message in bold."
      },
      "closeable": {
        "type": "boolean",
        "description": "When true, a close button is rendered in the top-right corner.",
        "default": false
      },
      "onClose": {
        "$comment": "() => void",
        "description": "Callback fired when the close button is clicked."
      },
      "icon": {
        "anyOf": [
          {
            "type": "object",
            "description": "DOM type: React.ReactElement"
          },
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "object",
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "DOM type: React.ReactPortal"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "anyOf": [
              {
                "type": "object",
                "description": "DOM type: React.ReactElement"
              },
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "object",
                "additionalProperties": false
              },
              {
                "type": "object",
                "description": "DOM type: React.ReactPortal"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "not": {}
              }
            ]
          }
        ],
        "description": "Custom icon to override the default severity icon."
      },
      "show": {
        "type": "boolean",
        "description": "Whether the alert is currently visible.",
        "default": true
      },
      "className": {
        "type": "string",
        "description": "Additional CSS class names applied to the root element."
      },
      "style": {
        "type": "object",
        "description": "DOM type: React.CSSProperties"
      }
    },
    "required": [
      "id",
      "message"
    ],
    "additionalProperties": false,
    "description": "Interface for the Alert component. Displays a short, important message to attract the user's attention.",
    "defaultValues": {
      "severity": "info",
      "closeable": "false",
      "show": "true"
    },
    "cssClasses": [
      "Cui-Alert__closeBtn",
      "Cui-Alert__content",
      "Cui-Alert__icon",
      "Cui-Alert__message",
      "Cui-Alert__title"
    ],
    "docs": {
      "imports": "import { Alert } from '@common-ui';",
      "demos": [
        {
          "exportName": "alertsDefaultDemo",
          "label": "Default",
          "code": [
            "() => {",
            "  return (",
            "    <div style={{ padding: 40, display: 'flex', flexDirection: 'column', gap: 12 }}>",
            "      <Alert id=\"info-alert\" severity=\"info\" message=\"This is an informational alert.\" />",
            "      <Alert id=\"success-alert\" severity=\"success\" message=\"Your changes were saved successfully.\" />",
            "      <Alert id=\"warning-alert\" severity=\"warning\" message=\"Disk usage is above 80%.\" />",
            "      <Alert id=\"error-alert\" severity=\"error\" message=\"Connection to the server was lost.\" />",
            "    </div>",
            "  );",
            "}"
          ]
        },
        {
          "exportName": "alertsWithTitleDemo",
          "label": "With Title",
          "code": [
            "() => {",
            "  return (",
            "    <div style={{ padding: 40, display: 'flex', flexDirection: 'column', gap: 12 }}>",
            "      <Alert",
            "        id=\"warning-titled\"",
            "        severity=\"warning\"",
            "        title=\"Low disk space\"",
            "        message=\"Your storage is almost full. Consider removing unused files.\"",
            "      />",
            "      <Alert",
            "        id=\"error-titled\"",
            "        severity=\"error\"",
            "        title=\"Authentication failed\"",
            "        message=\"Invalid credentials. Please check your username and password.\"",
            "      />",
            "    </div>",
            "  );",
            "}"
          ]
        },
        {
          "exportName": "alertsCloseableDemo",
          "label": "Closeable",
          "code": [
            "() => {",
            "  const [alerts, setAlerts] = useState([",
            "    { id: 'a1', severity: 'info',    message: 'Click × to dismiss this alert.' },",
            "    { id: 'a2', severity: 'success', message: 'Operation completed. Dismiss when ready.' },",
            "  ]);",
            "",
            "  const handleClose = (id) => setAlerts(prev => prev.filter(a => a.id !== id));",
            "",
            "  return (",
            "    <div style={{ padding: 40, display: 'flex', flexDirection: 'column', gap: 12 }}>",
            "      {alerts.map(a => (",
            "        <Alert",
            "          key={a.id}",
            "          id={a.id}",
            "          severity={a.severity}",
            "          message={a.message}",
            "          closeable",
            "          onClose={() => handleClose(a.id)}",
            "        />",
            "      ))}",
            "      {alerts.length === 0 && <p>All alerts dismissed.</p>}",
            "    </div>",
            "  );",
            "}"
          ]
        }
      ],
      "stories": [
        {
          "exportName": "Info",
          "label": "Info",
          "args": {
            "id": "demo-alert",
            "message": "This is an informational alert message.",
            "severity": "info"
          },
          "code": [
            "<Alert",
            "  id=\"demo-alert\"",
            "  message=\"This is an informational alert message.\"",
            "  severity=\"info\"",
            "/>"
          ]
        },
        {
          "exportName": "Success",
          "label": "Success",
          "args": {
            "id": "demo-alert",
            "message": "The operation completed successfully.",
            "severity": "success"
          },
          "code": [
            "<Alert",
            "  id=\"demo-alert\"",
            "  message=\"The operation completed successfully.\"",
            "  severity=\"success\"",
            "/>"
          ]
        },
        {
          "exportName": "Warning",
          "label": "Warning",
          "args": {
            "id": "demo-alert",
            "message": "Your storage is almost full. Consider removing unused files.",
            "severity": "warning",
            "title": "Low disk space"
          },
          "code": [
            "<Alert",
            "  id=\"demo-alert\"",
            "  message=\"Your storage is almost full. Consider removing unused files.\"",
            "  severity=\"warning\"",
            "  title=\"Low disk space\"",
            "/>"
          ]
        },
        {
          "exportName": "Error",
          "label": "Error",
          "args": {
            "id": "demo-alert",
            "message": "Could not reach the server. Please check your network settings.",
            "severity": "error",
            "title": "Connection failed"
          },
          "code": [
            "<Alert",
            "  id=\"demo-alert\"",
            "  message=\"Could not reach the server. Please check your network settings.\"",
            "  severity=\"error\"",
            "  title=\"Connection failed\"",
            "/>"
          ]
        },
        {
          "exportName": "Closeable",
          "label": "Closeable",
          "args": {
            "id": "demo-alert",
            "message": "Click the ✕ button to dismiss this alert.",
            "severity": "info",
            "closeable": true,
            "title": "Dismissable alert"
          },
          "code": [
            "<Alert",
            "  id=\"demo-alert\"",
            "  message=\"Click the ✕ button to dismiss this alert.\"",
            "  severity=\"info\"",
            "  closeable",
            "  title=\"Dismissable alert\"",
            "/>"
          ]
        }
      ]
    }
  },
