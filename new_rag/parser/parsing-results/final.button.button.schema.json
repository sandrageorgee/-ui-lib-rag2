[
  {
    "component": "button",
    "interface": "IButtonProps",
    "originalInterface": "IButtonProps",
    "dependencies": [
      "IButtonProps"
    ],
    "type": "object",
    "properties": {
      "variant": {
        "type": "string",
        "enum": [
          "primary",
          "secondary",
          "ghost",
          "danger"
        ],
        "description": "Visual style variant of the button.",
        "typeName": "ButtonVariant"
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ],
        "description": "Size of the button.",
        "typeName": "ButtonSize"
      },
      "loading": {
        "type": "boolean",
        "description": "When true, renders a spinner and disables the button.",
        "default": false
      },
      "leftIcon": {
        "tsType": "React.ReactNode",
        "description": "Optional icon rendered to the left of the label."
      },
      "rightIcon": {
        "tsType": "React.ReactNode",
        "description": "Optional icon rendered to the right of the label."
      },
      "label": {
        "type": "string",
        "description": "Label text displayed inside the button."
      }
    },
    "description": "Interface for the Button component. Extends all native HTML button attributes so consumers can pass onClick, disabled, type, aria-*, data-* and any other standard button prop.",
    "extends": [
      "React.ButtonHTMLAttributes<HTMLButtonElement>"
    ],
    "defaultValues": {
      "variant": "primary",
      "size": "md",
      "loading": false
    },
    "cssClasses": [
      "Cui-Button",
      "Cui-Button__label",
      "Cui-Button__leftIcon",
      "Cui-Button__rightIcon",
      "Cui-Button__spinner"
    ],
    "docs": {
      "imports": "import { Button } from '@common-ui';",
      "demos": [
        {
          "exportName": "buttonDefaultDemo",
          "label": "Default",
          "code": [
            "() => (",
            "  <div style={{ display: 'flex', gap: 12, padding: 40 }}>",
            "    <Button label=\"Primary\" variant=\"primary\" />",
            "    <Button label=\"Secondary\" variant=\"secondary\" />",
            "    <Button label=\"Ghost\" variant=\"ghost\" />",
            "    <Button label=\"Danger\" variant=\"danger\" />",
            "  </div>",
            ")"
          ]
        },
        {
          "exportName": "buttonSizesDemo",
          "label": "Sizes",
          "code": [
            "() => (",
            "  <div style={{ display: 'flex', gap: 12, alignItems: 'center', padding: 40 }}>",
            "    <Button label=\"Small\" size=\"sm\" />",
            "    <Button label=\"Medium\" size=\"md\" />",
            "    <Button label=\"Large\" size=\"lg\" />",
            "  </div>",
            ")"
          ]
        },
        {
          "exportName": "buttonLoadingDemo",
          "label": "Loading",
          "code": [
            "() => {",
            "  const [loading, setLoading] = React.useState(false);",
            "",
            "  const handleClick = () => {",
            "    setLoading(true);",
            "    setTimeout(() => setLoading(false), 2000);",
            "  };",
            "",
            "  return (",
            "    <div style={{ padding: 40 }}>",
            "      <Button",
            "        label={loading ? 'Saving...' : 'Save'}",
            "        loading={loading}",
            "        onClick={handleClick}",
            "      />",
            "    </div>",
            "  );",
            "}"
          ]
        },
        {
          "exportName": "buttonDisabledDemo",
