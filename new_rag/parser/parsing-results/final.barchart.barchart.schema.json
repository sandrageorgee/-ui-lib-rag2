        "type": "string",
        "description": "Id for the bar chart."
      },
      "data": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "description": "Label for the bar."
            },
            "xValue": {
              "type": "number",
              "description": "X-axis value for the bar."
            },
            "yValue": {
              "type": "number",
              "description": "Y-axis value for the bar."
            },
            "annotation": {
              "type": "string",
              "description": "Annotation for the bar."
            },
            "color": {
              "type": "string",
              "description": "Color of the bar.",
              "deprecated": "This property is no longer in use."
            },
            "tooltip": {
              "tsType": "ITooltip",
              "description": "Each series has its own tooltip configurations."
            },
            "itemStyle": {
              "type": "object",
              "properties": {
                "borderRadius": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  ],
                  "description": "Border radius.\n- Single number: all corners equal.\n- Array of four: [top-left, top-right, bottom-right, bottom-left]."
                },
                "borderWidth": {
                  "type": "number",
                  "description": "Border width in pixels."
                },
                "borderColor": {
                  "type": "string",
                  "description": "Border color."
                },
                "opacity": {
                  "type": "number",
                  "description": "Opacity from 0 (transparent) to 1 (opaque)."
                },
                "borderType": {
                  "type": "string",
                  "enum": [
                    "solid",
                    "dashed",
                    "dotted"
                  ],
                  "description": "Border style."
                }
              },
              "additionalProperties": false,
              "description": "Extra styling for the bar."
            }
          },
          "required": [
            "label",
            "yValue"
          ],
          "additionalProperties": false,
          "description": "Data for the bar chart.",
          "typeName": "IBarChartData"
        },
        "description": "Data for the bar chart.",
        "typeName": "IBarChartData[]"
      },
      "barProps": {
        "type": "object",
        "properties": {
          "width": {
            "type": "string",
            "description": "Width of the bar."
          },
          "color": {
            "type": "string",
            "description": "Color of the bar."
          },
          "showBarAboveGuidelines": {
            "type": "boolean",
            "description": "Flag to show bars above guidelines."
          }
        },
        "additionalProperties": false,
        "description": "Properties for individual bars.",
        "typeName": "IBarProps"
      },
      "xAxisProps": {
        "type": "object",
        "properties": {
          "xAxislabelsProps": {
            "tsType": "XAXisComponentOption[\"axisLabel\"]"
          }
        },
        "description": "Properties of the X-axis, extends IAxis with ECharts-specific label options."
      },
      "annotationAxisProps": {
        "type": "object",
        "properties": {
          "annotationsTextProps": {
            "tsType": "XAXisComponentOption[\"axisLabel\"]"
          }
        },
        "description": "Properties of the annotation axis (second X-axis used for annotations)."
      },
      "thresholdProps": {
        "type": "object",
        "properties": {
          "threshold": {
            "type": "number",
            "description": "Value of the threshold."
          },
          "aboveThresholdColor": {
            "type": "string",
            "description": "Color for bars above the threshold."
          },
          "thresholdLineColor": {
            "type": "string",
            "description": "Color of the threshold line."
          },
          "labelStyle": {
            "tsType": "React.CSSProperties",
            "description": "Style for the threshold label."
          },
          "showAnimationOnTouch": {
            "type": "boolean",
            "description": "Flag to show animation when touched."
          },
          "formatter": {
            "type": "string",
            "description": "Formatter for the threshold label."
          }
        },
        "additionalProperties": false,
        "description": "Properties for the threshold line and colors.",
        "typeName": "IThresholdProps"
      }
    },
    "required": [
      "data"
    ],
    "description": "Props for the BarChart component.",
    "extends": [
      "IChartProps"
    ],
    "docs": {
      "imports": "import { BarChart } from '@common-ui';",
      "demos": [
        {
          "exportName": "barchartDefaultDemo",
          "label": "Default",
          "code": [
            "() => {",
            "  const data = [",
            "    { label: 'Jan', yValue: 120 },",
            "    { label: 'Feb', yValue: 85 },",
            "    { label: 'Mar', yValue: 200 },",
            "    { label: 'Apr', yValue: 150 },",
            "    { label: 'May', yValue: 170 },",
            "  ];",
            "  return (",
            "    <div style={{ width: 600, height: 300, padding: 20 }}>",
            "      <BarChart",
            "        id=\"default-bar\"",
            "        data={data}",
            "        title=\"Monthly Sales\"",
            "        showToolTip",
            "        showAnimation",
            "        yAxisProps={{ label: 'Units', showGuidelines: true }}",
            "        xAxisProps={{ label: 'Month' }}",
            "      />",
            "    </div>",
            "  );",
            "}"
          ]
        },
        {
          "exportName": "barchartThresholdDemo",
          "label": "Threshold",
          "code": [
            "() => {",
            "  const data = [",
            "    { label: 'Q1', yValue: 80 },",
            "    { label: 'Q2', yValue: 160 },",
            "    { label: 'Q3', yValue: 130 },",
            "    { label: 'Q4', yValue: 95 },",
            "  ];",
            "  return (",
            "    <div style={{ width: 600, height: 300, padding: 20 }}>",
            "      <BarChart",
            "        id=\"threshold-bar\"",
            "        data={data}",
            "        title=\"Quarterly Revenue\"",
            "        showToolTip",
            "        thresholdProps={{",
            "          threshold: 120,",
            "          aboveThresholdColor: 'rgba(255, 38, 64, 1)',",
            "          thresholdLineColor: '#E55C6C',",
            "          formatter: 'Target: {value}',",
            "        }}",
            "        yAxisProps={{ label: 'Revenue ($K)', showGuidelines: true }}",
            "      />",
            "    </div>",
            "  );",
            "}"
          ]
        },
        {
          "exportName": "barchartZoomDemo",
          "label": "Zoom",
          "code": [
            "() => {",
            "  const data = Array.from({ length: 20 }, (_, i) => ({",
            "    label: \\`W\\${i + 1}\\`,",
            "    yValue: Math.floor(Math.random() * 200) + 50,",
            "  }));",
            "  return (",
            "    <div style={{ width: 600, height: 300, padding: 20 }}>",
            "      <BarChart",
            "        id=\"zoom-bar\"",
            "        data={data}",
            "        title=\"Weekly Data (Scroll to Zoom)\"",
            "        showToolTip",
            "        allowZoom",
            "        zoomProps={{ disableYaxisZoom: true, start: 0, end: 50 }}",
            "        yAxisProps={{ showGuidelines: true }}",
            "      />",
            "    </div>",
            "  );",
            "}"
          ]
        },
        {
          "exportName": "barchartAnnotationsDemo",
          "label": "Annotations",
          "code": [
            "() => {",
            "  const data = [",
            "    { label: 'Mon', yValue: 45,  annotation: '+5%' },",
            "    { label: 'Tue', yValue: 90,  annotation: '+12%' },",
            "    { label: 'Wed', yValue: 60,  annotation: '-8%' },",
            "    { label: 'Thu', yValue: 110, annotation: '+22%' },",
            "    { label: 'Fri', yValue: 75,  annotation: '+3%' },",
            "  ];",
            "  return (",
            "    <div style={{ width: 600, height: 300, padding: 20 }}>",
            "      <BarChart",
            "        id=\"annotations-bar\"",
            "        data={data}",
            "        title=\"Daily Performance\"",
            "        showToolTip",
            "        showAnimation",
            "        yAxisProps={{ label: 'Score', showGuidelines: true }}",
            "      />",
            "    </div>",
            "  );",
            "}"
          ]
        }
      ],
