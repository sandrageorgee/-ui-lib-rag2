  "component": "Input",
  "text": "This is the full implementation of the Input component.\n\nCode:\nimport React from \"react\";\nimport { IInputProps } from \"./Input.types\";\n\n/**\n * Input Component\n */\nconst Input: React.FC<IInputProps> = (props) => {\n    const {\n        defaultValue,\n        onClick,\n        onChange,\n        inputRef,\n        disabled,\n        label,\n        placeholder,\n        type = \"text\",\n    } = props;\n\n    return (\n        <div style={{ display: \"flex\", flexDirection: \"column\", gap: \"4px\" }}>\n            {label && <label>{label}</label>}\n\n            <input\n                ref={inputRef as any}\n                defaultValue={defaultValue}\n                onClick={onClick}\n                onChange={onChange}\n                disabled={disabled}\n                placeholder={placeholder}\n                type={type}\n                style={{\n                    padding: \"8px\",\n                    borderRadius: \"6px\",\n                    border: \"1px solid #ccc\",\n                }}\n            />\n        </div>\n    );\n};\n\nexport default Input;",
