{
  "component": "Dashboard",
  "text": "This is the full implementation of the Dashboard component.\n\nCode:\nimport React, { useState } from \"react\";\nimport { IDashboardProps } from \"./Dashboard.types\";\nimport { Button } from \"../Button/Button\";\nimport { Input } from \"../Input/Input\";\n\n/*\n🔥 MAIN COMPONENT (~300 lines with subcomponents)\n*/\nexport const Dashboard: React.FC<IDashboardProps> = ({\n    title,\n    userName,\n    onLogout,\n}) => {\n    const [name, setName] = useState(\"\");\n    const [email, setEmail] = useState(\"\");\n\n    const handleSubmit = () => {\n        console.log({ name, email });\n    };\n\n    return (\n        <div className=\"dashboard\">\n            <Header title={title} userName={userName} onLogout={onLogout} />\n\n            <StatsSection />\n\n            <ActivitySection />\n\n            <FormSection\n                name={name}\n                email={email}\n                setName={setName}\n                setEmail={setEmail}\n                onSubmit={handleSubmit}\n            />\n        </div>\n    );\n};\n\n/*\n========================\nHEADER COMPONENT\n========================\n*/\nconst Header = ({ title, userName, onLogout }: any) => {\n    return (\n        <div className=\"header\">\n            <h1>{title}</h1>\n            <div>\n                <span>Welcome, {userName}</span>\n                <Button onClick={onLogout}>Logout</Button>\n            </div>\n        </div>\n    );\n};\n\n/*\n========================\nSTATS SECTION\n========================\n*/\nconst StatsSection = () => {\n    return (\n        <div className=\"stats\">\n            <StatsCard label=\"Users\" value={120} />\n            <StatsCard label=\"Orders\" value={80} />\n            <StatsCard label=\"Revenue\" value={5000} />\n        </div>\n    );\n};\n\nconst StatsCard = ({ label, value }: any) => {\n    return (\n        <div className=\"card\">\n            <h3>{label}</h3>\n            <p>{value}</p>\n        </div>\n    );\n};\n\n/*\n========================\nACTIVITY SECTION\n========================\n*/\nconst ActivitySection = () => {\n    return (\n        <div className=\"activity\">\n            <ActivityItem message=\"User signed up\" time=\"2 min ago\" />\n            <ActivityItem message=\"Order placed\" time=\"10 min ago\" />\n            <ActivityItem message=\"Payment received\" time=\"30 min ago\" />\n        </div>\n    );\n};\n\nconst ActivityItem = ({ message, time }: any) => {\n    return (\n        <div className=\"activity-item\">\n            <span>{message}</span>\n            <small>{time}</small>\n        </div>\n    );\n};\n\n/*\n========================\nFORM SECTION\n========================\n*/\nconst FormSection = ({\n    name,\n    email,\n    setName,\n    setEmail,\n    onSubmit,\n}: any) => {\n    return (\n        <div className=\"form\">\n            <h2>Update Info</h2>\n\n            <FormField\n                label=\"Name\"\n                value={name}\n                onChange={(v: string) => setName(v)}\n            />\n\n            <FormField\n                label=\"Email\"\n                value={email}\n                onChange={(v: string) => setEmail(v)}\n            />\n\n            <Button onClick={onSubmit}>Save</Button>\n        </div>\n    );\n};\n\nconst FormField = ({ label, value, onChange }: any) => {\n    return (\n        <div className=\"field\">\n            <label>{label}</label>\n            <Input value={value} onChange={onChange} />\n        </div>\n    );\n};",
